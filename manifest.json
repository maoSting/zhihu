{
  "manifest_version": 3,
  "name": "知乎历史助手",
  "default_locale": "zh_CN",
  "version": "3.0.1",
  "description": "在知乎首页浏览问题答案时无法产生浏览记录，该扩展可以生成浏览记录。",
  "icons": {
    "16": "static/images/icon_16.png",
    "32": "static/images/icon_32.png",
    "48": "static/images/icon_48.png",
    "128": "static/images/icon_128.png"
  },
  "permissions": [
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "apps/background/background.js"
  },
  "action": {
    "default_popup": "apps/donate/donate.html"
  },
  "host_permissions": [
    "https://www.zhihu.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.zhihu.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "static/js/jquery-3.6.0.min.js",
        "apps/content/contentScript.js"
      ]
    }
  ]
}